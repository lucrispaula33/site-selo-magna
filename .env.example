# ─────────────────────────────────────────────────────────────
# Copie este arquivo como ".env.local" (no computador) ou
# cadastre estas variáveis na Netlify (Site configuration → Environment variables).
# NENHUMA é obrigatória para o site funcionar.
# ─────────────────────────────────────────────────────────────

# Endereço oficial do site. Quando comprar o domínio, troque aqui (ex.: https://www.selomagna.com.br)
NEXT_PUBLIC_SITE_URL=https://www.selomagna.com.br

# Brevo (e-mail marketing + aviso de novo contato) — https://app.brevo.com
BREVO_API_KEY=
BREVO_LIST_ID=2
# E-mail que recebe o aviso de cada novo lead
LEAD_NOTIFY_EMAIL=contato@selomagna.com.br
# Remetente verificado no Brevo
BREVO_SENDER_EMAIL=contato@selomagna.com.br

# Google Analytics 4 (opcional) — só carrega após o visitante aceitar cookies
NEXT_PUBLIC_GA_ID=

# Google Search Console — código de verificação (opcional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
